# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── Qdrant ───────────────────────────────────────────────────────────────────
# Set USE_QDRANT_CLOUD=true and fill in URL + KEY to use Qdrant Cloud.
# Compose uses this local endpoint automatically for the backend container.
USE_QDRANT_CLOUD=false
QDRANT_CLOUD_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_URL=http://localhost:6333
LAW_COLLECTION=law_collection
FAQ_COLLECTION=faq_collection
CORPUS_VERSION=epr-corpus-v1

# ── Redis ────────────────────────────────────────────────────────────────────
# Redis is only for answer cache, hot context, and rate limiting. PostgreSQL is
# the durable source of truth for conversations, case states, and agent runs.
#
# Dev — backend chạy TRÊN MÁY (uvicorn), Redis trong Docker:
#   1) Bật Docker Desktop, rồi:  docker compose up -d redis
#   2) Giữ REDIS_URL trỏ localhost (port map 127.0.0.1:6379 trong compose).
#
# Full stack — mọi thứ trong docker compose: backend đã override REDIS_URL=redis://redis:6379/0
# (không cần sửa .env cho Redis khi chỉ dùng compose up toàn bộ stack).
#
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_THRESHOLD=0.95

# ── Durable persistence ──────────────────────────────────────────────────────
# Local development may leave DATABASE_URL unset and use HISTORY_DB_PATH.
# Compose overrides DATABASE_URL with its PostgreSQL service.
DATABASE_URL=
HISTORY_DB_PATH=data/chat_history.sqlite3

# ── LangSmith (optional) ─────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key-here

# ── Tavily web search (optional) ─────────────────────────────────────────────
TAVILY_API_KEY=your-tavily-api-key-here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Set to your server IP or internal hostname.
# Example: http://192.168.1.50,http://epr.internal
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8501

# ── Authentication ────────────────────────────────────────────────────────────
# Comma-separated list of valid API keys (e.g. 'key1,key2,my-secret-key')
# Clients must send: X-API-Key: <your-key>
# Set REQUIRE_AUTH=false to disable auth (development only)
API_KEYS=your-api-key-here
REQUIRE_AUTH=true

# ── Pipeline Feature Flags (Option A minimal controls) ─────────────────────
ENABLE_QUERY_REWRITE=true
ENABLE_STRICT_FAQ_GATE=true
ENABLE_RELEVANCE_GATE=true
ENABLE_WEB_FALLBACK=true
ENABLE_LEGAL_EVIDENCE_GUARDRAIL=true
MIN_LEGAL_EVIDENCE_DOCS=1
MIN_LEGAL_EVIDENCE_CHARS=160

# ── Index Contract Validation ───────────────────────────────────────────────
# Fail early when source/index records are malformed.
INDEX_CONTRACT_STRICT=true
