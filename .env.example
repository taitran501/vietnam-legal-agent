# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=replace-with-openai-api-key

# ── Qdrant ───────────────────────────────────────────────────────────────────
# Set USE_QDRANT_CLOUD=true and fill in URL + KEY to use Qdrant Cloud.
# Compose uses this local endpoint automatically for the backend container.
USE_QDRANT_CLOUD=false
QDRANT_CLOUD_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_URL=http://localhost:6333
LAW_COLLECTION=law_collection
CORPUS_ID=epr
CORPUS_VERSION=epr-law-structure-v4-amendment-chain
INDEX_SCHEMA_VERSION=legal-structure-v2
ENABLE_TRACE_DEBUG_API=false
ENABLE_UNIVERSAL_RETRIEVAL=false
# Pipeline mode: 'pipeline-v4' (Deterministic Bounded Workflow) or 'pipeline-agent' (Autonomous ReAct Cognitive Loop)
AGENT_PIPELINE_VERSION=pipeline-v4
APPENDIX_XXII_DATA_PATH=artifacts/appendix_xxii.jsonl
AMENDMENT_MAP_PATH=data/amendment_map.json
RULE_PACK_PATH=data/epr_rule_pack.json
# Optional snapshot date for a content-locked release. Set it together with
# synchronized corpus metadata; this is a technical release input, not a
# reviewer approval field.
CORPUS_AS_OF_DATE=
V4_ROUTE_CONFIDENCE_THRESHOLD=0.70

# ── Redis ────────────────────────────────────────────────────────────────────
# Redis is only for answer cache, hot context, and rate limiting. PostgreSQL is
# the durable source of truth for conversations, case states, and agent runs.
#
# Host-run development requires a Redis service reachable through REDIS_URL.
# The Compose Redis service is intentionally private to the Compose network.
# In the full stack, Compose overrides this value with redis://redis:6379/0.
#
REDIS_URL=redis://localhost:6379/0
# Redis AUTH password (required for Compose; optional for local dev)
REDIS_PASSWORD=
AGENT_MAX_IN_FLIGHT_TURNS=50
AGENT_ADMISSION_WAIT_SECONDS=2
AGENT_LEASE_TTL_SECONDS=300
AGENT_LEASE_HEARTBEAT_SECONDS=30
DOCUMENT_MAX_IN_FLIGHT_UPLOADS=10
# Keep false in production: legal/API traffic is blocked if request protection
# cannot reach Redis. Set true only for an explicitly isolated local preview.
RATE_LIMIT_FAIL_OPEN=false
CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_THRESHOLD=0.95

# ── Durable persistence ──────────────────────────────────────────────────────
# Local development may leave DATABASE_URL unset and use HISTORY_DB_PATH.
# Compose overrides DATABASE_URL with its PostgreSQL service.
DATABASE_URL=
# Compose refuses to start without this password. Use a long random value and
# keep it consistent with any DATABASE_URL used outside Compose.
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
HISTORY_DB_PATH=data/chat_history.sqlite3

# ── LangSmith (optional) ─────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key-here

# ── Tavily web search (optional) ─────────────────────────────────────────────
TAVILY_API_KEY=your-tavily-api-key-here
WEB_OFFICIAL_DOMAINS=vanban.chinhphu.vn,vbpl.vn
WEB_EXCERPT_MAX_CHARS=1200

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Set to your server IP or internal hostname.
# Example: http://192.168.1.50,http://epr.internal
# Same-origin Compose deployments can leave this empty. For a direct local
# Vite-to-API run, set e.g. http://localhost:3000 explicitly.
ALLOWED_ORIGINS=

# ── Authentication ────────────────────────────────────────────────────────────
# Legacy API keys remain a one-release compatibility bridge for non-browser callers.
API_KEYS=your-api-key-here
SERVICE_TOKEN_DEFINITIONS=
# Format: name:sha256(token):scope1|scope2:role1|role2
# HMAC salt for legacy API key derivation (change in production)
LEGACY_HMAC_KEY=epr-owner-v2
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_REQUIRED_GROUP=
OIDC_ALLOWED_ALGORITHMS=RS256
TRUSTED_PROXY_IPS=
# Set REQUIRE_AUTH=false only for explicit local deterministic tests.
REQUIRE_AUTH=true

# ── Pipeline Feature Flags (Option A minimal controls) ─────────────────────
ENABLE_RELEVANCE_GATE=true
ENABLE_LEGAL_EVIDENCE_GUARDRAIL=true
MIN_LEGAL_EVIDENCE_DOCS=1
MIN_LEGAL_EVIDENCE_CHARS=160

# ── Index Contract Validation ───────────────────────────────────────────────
# Fail early when source/index records are malformed.
INDEX_CONTRACT_STRICT=true
# Corpus safety mode. Keep production in deployed environments; preview is for local/staging validation only.
CORPUS_RUNTIME_MODE=production
